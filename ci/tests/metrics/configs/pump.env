# Base Pump configuration shared by every profile. The whole Pump config comes
# from environment variables, so the suite exercises the same TYK_PMP_* surface
# operators use. Each profile's pump.env is loaded after this file and only
# sets the opentelemetry.metrics block.
#
# The image ships pump.example.conf as its config file; ignore it.
TYK_PMP_OMITCONFIGFILE=true
TYK_PMP_LOGLEVEL=info
TYK_PMP_PURGEDELAY=2
TYK_PMP_ANALYTICSSTORAGETYPE=redis
TYK_PMP_ANALYTICSSTORAGECONFIG_TYPE=redis
TYK_PMP_ANALYTICSSTORAGECONFIG_HOST=redis
TYK_PMP_ANALYTICSSTORAGECONFIG_PORT=6379
# One dummy pump and no uptime pump: P1 needs no datastore.
TYK_PMP_PUMPS_DUMMY_TYPE=dummy
TYK_PMP_DONTPURGEUPTIMEDATA=true
TYK_PMP_HEALTHCHECKENDPOINTNAME=health
TYK_PMP_HEALTHCHECKENDPOINTPORT=8083
