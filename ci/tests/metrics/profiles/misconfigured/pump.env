# Misconfigured profile: metrics are enabled with an exporter that does not
# exist. The Pump must still boot, serve /health and pump, log exactly one
# warning naming the problem, and export nothing.
TYK_PMP_OPENTELEMETRY_METRICS_ENABLED=true
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTER=bogus
TYK_PMP_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTINTERVAL=2
TYK_PMP_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=e2e
