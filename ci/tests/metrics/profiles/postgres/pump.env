# Postgres profile: the uptime pump is the SQL one on Postgres, so the uptime
# series carries store="postgres".
TYK_PMP_OPENTELEMETRY_METRICS_ENABLED=true
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTER=grpc
TYK_PMP_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTINTERVAL=2
TYK_PMP_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=e2e
TYK_PMP_UPTIMEPUMPCONFIG_UPTIMETYPE=sql
TYK_PMP_UPTIMEPUMPCONFIG_TYPE=postgres
TYK_PMP_UPTIMEPUMPCONFIG_CONNECTIONSTRING=host=postgres port=5432 user=tyk password=tyk dbname=tyk_analytics sslmode=disable
