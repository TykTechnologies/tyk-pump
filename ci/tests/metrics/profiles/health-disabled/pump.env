# Health-disabled profile: metrics export is on but the self-health family is
# off. process.uptime keeps flowing; tyk_pump_health must never appear.
TYK_PMP_OPENTELEMETRY_METRICS_ENABLED=true
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTER=grpc
TYK_PMP_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTINTERVAL=2
TYK_PMP_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=e2e
TYK_PMP_OPENTELEMETRY_METRICS_HEALTHMETRICS=false
