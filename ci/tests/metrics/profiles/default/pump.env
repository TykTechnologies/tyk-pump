# Default profile: OTLP metrics export enabled with full identity.
TYK_PMP_OPENTELEMETRY_METRICS_ENABLED=true
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTER=grpc
TYK_PMP_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTINTERVAL=2
TYK_PMP_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=e2e
# The Mongo uptime pump, so tyk.pump.health has an uptime datastore to probe.
TYK_PMP_DONTPURGEUPTIMEDATA=false
TYK_PMP_UPTIMEPUMPCONFIG_MONGOURL=mongodb://mongo:27017/tyk_analytics
TYK_PMP_UPTIMEPUMPCONFIG_COLLECTIONNAME=tyk_uptime_analytics
