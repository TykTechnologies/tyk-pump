# Pumps profile: one pump per write outcome, all fed by the Gateway's real
# analytics. The base "dummy" pump succeeds on every write. Env-defined pump
# names cannot contain "_", so the configured names (and the `pump` label) are
# single words.
TYK_PMP_OPENTELEMETRY_METRICS_ENABLED=true
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTER=grpc
TYK_PMP_OPENTELEMETRY_METRICS_ENDPOINT=otel-collector:4317
TYK_PMP_OPENTELEMETRY_METRICS_EXPORTINTERVAL=2
TYK_PMP_OPENTELEMETRY_METRICS_DEPLOYMENTENVIRONMENT=e2e
TYK_PMP_PURGEDELAY=1
# filtered: its filters drop the first test API's records.
TYK_PMP_PUMPS_FILTERED_TYPE=dummy
TYK_PMP_PUMPS_FILTERED_FILTERS_SKIPPEDAPIIDS=pump-metrics-api-1
# splunkdown: initialises, but its collector is a closed port, so every write
# returns an error.
TYK_PMP_PUMPS_SPLUNKDOWN_TYPE=splunk
TYK_PMP_PUMPS_SPLUNKDOWN_META_COLLECTORTOKEN=e2e-token
TYK_PMP_PUMPS_SPLUNKDOWN_META_COLLECTORURL=http://localhost:1
# mongoslow: healthy until the test pauses its Mongo, then times out after 2s.
TYK_PMP_PUMPS_MONGOSLOW_TYPE=mongo
TYK_PMP_PUMPS_MONGOSLOW_TIMEOUT=2
TYK_PMP_PUMPS_MONGOSLOW_META_MONGOURL=mongodb://mongo:27017/tyk_analytics
TYK_PMP_PUMPS_MONGOSLOW_META_COLLECTIONNAME=tyk_analytics
# splunknoinit: no collector_token, so Init fails and the pump is skipped.
TYK_PMP_PUMPS_SPLUNKNOINIT_TYPE=splunk
TYK_PMP_PUMPS_SPLUNKNOINIT_META_COLLECTORURL=http://localhost:1
# notregistered: a type the Pump does not know, so it is skipped.
TYK_PMP_PUMPS_NOTREGISTERED_TYPE=does-not-exist
